{
  // Type checking only: Node 24 runs the .ts sources directly (type stripping), tsc never emits.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    // Node's type stripping cannot run enums, namespaces or parameter properties
    "erasableSyntaxOnly": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "test", "tools", "types"]
}
