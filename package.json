{
  "name": "warcraft-dune",
  "version": "0.1.0",
  "private": true,
  "description": "Build pipeline that converts the user's own Emperor: Battle for Dune data into a Warcraft III campaign (.w3n)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "tsc -p .",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config --fix .",
    "test": "tsc -p . && eslint --flag unstable_native_nodejs_ts_config . && node --test \"test/**/*.test.ts\"",
    "test:fast": "node --test \"test/**/*.test.ts\"",
    "smoke": "node src/smoke/build-smoke.ts",
    "campaign": "node src/emperor/build-campaign.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.12.0",
    "gifenc": "^1.0.3",
    "mdx-m3-viewer": "^5.12.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
